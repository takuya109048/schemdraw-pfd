{
  "version": 1,
  "layout": "flow",
  "custom_elements": [
    {"name": "fired_heater", "width": 4, "height": 6, "label_pos": "above",
     "shapes": [
       {"type": "polyline", "closed": true, "points": [[0, 0], [4, 0], [4, 4], [3, 5], [3, 6], [1, 6], [1, 5], [0, 4]]},
       {"type": "polyline", "boundary": false, "points": [[0, 1], [3, 1], [1, 2], [3, 3], [1, 4], [4, 5]]}
     ],
     "ports": {"in": {"side": "W", "offset": 1}, "out": {"side": "E", "offset": 4}}},
    {"name": "compressor", "width": 4, "height": 4, "label_pos": "below",
     "shapes": [{"type": "polyline", "closed": true, "points": [[0, 0], [0, 4], [4, 3], [4, 1]]}],
     "ports": {"in": {"side": "W", "offset": 2}, "out": {"side": "E", "offset": 2}}}
  ],
  "elements": [
    {"id": "TOL", "type": "connector", "params": {"text": "Toluene\nfeed"}},
    {"id": "H2", "type": "connector", "params": {"text": "Hydrogen\nfeed"}},
    {"id": "V-101", "type": "horizontal_drum", "desc": "Toluene feed drum"},
    {"id": "P-101A", "type": "pump", "desc": "Toluene feed pump"},
    {"id": "E-101", "type": "heat_exchanger", "desc": "Feed preheater"},
    {"id": "H-101", "type": "fired_heater", "desc": "Heater"},
    {"id": "R-101", "type": "vertical_drum", "desc": "Reactor"},
    {"id": "E-102", "type": "heat_exchanger", "desc": "Reactor effluent cooler"},
    {"id": "V-102", "type": "vertical_drum", "desc": "High-pressure\nphase separator"},
    {"id": "LIC-102", "type": "instrument", "params": {"function": "LIC", "number": "102", "mount": "dcs"}},
    {"id": "C-101", "type": "compressor", "desc": "Recycle gas compressor"},
    {"id": "FG1", "type": "connector", "params": {"text": "Fuel gas\n(purge)", "local": true}},
    {"id": "V-103", "type": "vertical_drum", "params": {"width": 4, "height": 6}, "desc": "Low-pressure\nphase separator"},
    {"id": "FG2", "type": "connector", "params": {"text": "Fuel gas", "local": true}},
    {"id": "CWS", "type": "connector", "params": {"text": "CWS", "point": "left"}},
    {"id": "CWR", "type": "connector", "params": {"text": "CWR"}},
    {"id": "STM", "type": "connector", "params": {"text": "Steam", "point": "left"}},
    {"id": "CND", "type": "connector", "params": {"text": "Condensate"}},
    {"id": "E-103", "type": "heat_exchanger", "desc": "Feed heater"},
    {"id": "T-101", "type": "column", "desc": "Benzene column"},
    {"id": "E-106", "type": "heat_exchanger", "params": {"orientation": "vertical", "length": 10}, "desc": "Benzene reboiler"},
    {"id": "E-104", "type": "heat_exchanger", "ports": {"vap": ["W", 1]}, "desc": "Benzene condenser"},
    {"id": "V-104", "type": "horizontal_drum", "desc": "Reflux drum"},
    {"id": "P-102A", "type": "pump", "desc": "Reflux pump"},
    {"id": "E-105", "type": "heat_exchanger", "params": {"length": 8}, "desc": "Product cooler"},
    {"id": "BZ", "type": "connector", "params": {"text": "Benzene\nproduct"}}
  ],
  "connections": [
    {"from": "TOL.tip", "to": "V-101.n1"},
    {"from": "V-101.s_mid", "to": "P-101A.in"},
    {"from": "P-101A.out", "to": "E-101.tube_in", "inline": [{"type": "valve", "id": "FV-101", "params": {"kind": "control"}}]},
    {"from": "H2.tip", "to": "E-101.tube_in"},
    {"from": "E-101.tube_out", "to": "H-101.in"},
    {"from": "H-101.out", "to": "R-101.w6"},
    {"from": "R-101.bottom", "to": "E-102.tube_in"},
    {"from": "E-102.tube_out", "to": "V-102.w5"},
    {"from": "V-102.top", "to": "C-101.in"},
    {"from": "V-102.top", "to": "FG1.tail", "inline": [{"type": "valve", "id": "PV-102", "params": {"kind": "control"}}]},
    {"from": "C-101.out", "to": "E-101.tube_in", "recycle": true},
    {"from": "C-101.out", "to": "R-101.w3", "recycle": true},
    {"from": "V-102.bottom", "to": "V-103.w2", "inline": [{"type": "valve", "id": "LV-102", "params": {"kind": "control"}}]},
    {"from": "V-102.e2", "to": "LIC-102.w", "type": "instrument"},
    {"from": "LIC-102.s", "to": "LV-102.signal", "type": "signal"},
    {"from": "V-103.top", "to": "FG2.tail"},
    {"from": "V-103.bottom", "to": "E-103.tube_in"},
    {"from": "E-103.tube_out", "to": "T-101.w8"},
    {"from": "T-101.top", "to": "E-104.vap"},
    {"from": "E-104.shell_out", "to": "V-104.n1"},
    {"from": "V-104.s5", "to": "P-102A.in"},
    {"from": "P-102A.out", "to": "T-101.e16", "recycle": true, "inline": [{"type": "valve", "id": "FV-104", "params": {"kind": "control"}}]},
    {"from": "P-102A.out", "to": "E-105.tube_in"},
    {"from": "E-105.tube_out", "to": "BZ.tail", "inline": [{"type": "valve", "id": "LV-104", "params": {"kind": "control"}}]},
    {"from": "T-101.e2", "to": "E-106.shell_in"},
    {"from": "E-106.tube_out", "to": "T-101.e10", "recycle": true},
    {"from": "T-101.bottom", "to": "V-101.n5", "recycle": true},
    {"from": "CWS.tip", "to": "E-102.shell_in_s", "type": "utility"},
    {"from": "E-102.shell_out_n", "to": "CWR.tail", "type": "utility"},
    {"from": "STM.tip", "to": "E-106.shell_out", "type": "utility", "inline": [{"type": "valve", "id": "TV-106", "params": {"kind": "control"}}]},
    {"from": "E-106.shell_in_s", "to": "CND.tail", "type": "utility"}
  ]
}
